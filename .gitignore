# Kura AI — gitignore
# Secret dan file lokal/build tidak boleh masuk Git.

# Kredensial Sensitif & Kunci Rilis
.env
.env.*
*.jks
*.keystore
key.properties
google-services.json

# Environment files
.env
.env.local
.env.*.local
backend/.env

# Flutter / Dart
**/.dart_tool/
**/build/
frontend/.packages
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/pubspec.lock

# Android
**/.gradle/
**/local.properties
**/key.properties
**/app/google-services.json
*.keystore
*.jks

# IDE & Editor
**/.idea/
**/*.iml
**/.vscode/
*.swp
*.swo

# Antigravity / AI local artifacts
.system_generated/
.user_uploaded/

# Python / Backend
**/__pycache__/
backend/*.pyc
backend/*.pyo
backend/.venv/
backend/venv/

# OS
.DS_Store
Thumbs.db
