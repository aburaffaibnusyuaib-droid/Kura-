# Backend Kura AI — Environment Variables Template
# Salin file ini menjadi .env dan isi nilai yang sesuai.
# JANGAN commit .env ke Git. Service-role key hanya di backend, tidak pernah di Flutter.

GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
